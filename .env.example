# AprioriX-FIM-Optimization Environment Configuration
# Copy this file to .env and adjust values as needed

# ============================================
# Python Environment
# ============================================
PYTHON_VERSION=3.10
VENV_PATH=.venv

# ============================================
# Dataset Configuration
# ============================================
# Path to dataset directory
DATASET_DIR=src/datasets

# Which datasets to benchmark (comma-separated)
# Options: chess.dat, connect.dat, accidents.dat
DATASETS_TO_TEST=chess.dat,connect.dat,accidents.dat

# ============================================
# Benchmark Configuration
# ============================================
# Minimum support thresholds to test (comma-separated, as decimals)
MIN_SUPPORT_THRESHOLDS=0.1,0.2,0.4

# Enable verbose output
VERBOSE=true

# Number of runs per benchmark (for averaging)
NUM_RUNS=1

# ============================================
# Performance Profiling
# ============================================
# Enable memory profiling with psutil
PROFILE_MEMORY=true

# Enable timing profiling
PROFILE_TIME=true

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Output Configuration
# ============================================
# Results output directory
RESULTS_DIR=results

# Generate graphs (requires matplotlib)
GENERATE_GRAPHS=true

# Output format (csv, json, markdown, all)
OUTPUT_FORMAT=csv

# ============================================
# Advanced Optimization Options
# ============================================
# Enable transaction reduction in vertical format
ENABLE_TRANSACTION_REDUCTION=true

# Use pruning optimization
ENABLE_PRUNING=true

# Maximum memory allowed (MB) - 0 = unlimited
MAX_MEMORY_MB=0

# Timeout for single algorithm run (seconds) - 0 = unlimited
TIMEOUT_SECONDS=300

# ============================================
# Dataset Generation (for synthetic data)
# ============================================
# Number of transactions for chess dataset
CHESS_TRANSACTIONS=3196
CHESS_ITEMS=75
CHESS_MIN_LENGTH=30
CHESS_MAX_LENGTH=40

# Number of transactions for connect dataset
CONNECT_TRANSACTIONS=10000
CONNECT_ITEMS=129
CONNECT_MIN_LENGTH=35
CONNECT_MAX_LENGTH=43

# Number of transactions for accidents dataset
ACCIDENTS_TRANSACTIONS=15000
ACCIDENTS_ITEMS=468
ACCIDENTS_MIN_LENGTH=20
ACCIDENTS_MAX_LENGTH=45

# ============================================
# Report Configuration
# ============================================
# Report output format
REPORT_FORMAT=markdown

# Include graphs in report
INCLUDE_GRAPHS=true

# Author name for report
AUTHOR_NAME=Your Team Name

# Report title
REPORT_TITLE=Comparison of Apriori Algorithm with Optimizations
